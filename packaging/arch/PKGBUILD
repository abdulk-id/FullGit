# Maintainer: Abdul Kareem <235873002+abdulk-id@users.noreply.github.com>

pkgname=fullgit-git
_pkgname=FullGit
pkgver=r11.f6d7fb5
pkgrel=1
pkgdesc='Issues, pull requests, permissions, secrets and per-user files that travel with your git repository'
arch=('x86_64' 'aarch64')
url='https://github.com/abdulk-id/FullGit'
license=('MIT')
# fullgit runs git and ssh-keygen.
depends=('git' 'glibc' 'libgcc' 'openssh' 'zlib')
makedepends=('cargo' 'git')
# makepkg's LTO compiles the bundled libgit2 to GCC bitcode, which Rust's
# linker can't read.
options=('!lto')
provides=('fullgit')
conflicts=('fullgit')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --package fullgit
}

check() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release --workspace
}

package() {
  cd "$_pkgname"
  install -Dm755 target/release/fullgit "$pkgdir/usr/bin/fullgit"
  # Lets `git fullgit ...` work.
  ln -s fullgit "$pkgdir/usr/bin/git-fullgit"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md DESIGN.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
